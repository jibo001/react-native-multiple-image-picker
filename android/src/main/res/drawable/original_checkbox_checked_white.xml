<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval"
            android:useLevel="false">
            <solid android:color="#FFFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFFFF" />
            <size
                android:width="15dp"
                android:height="15dp" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_original_check_black"
        android:gravity="center"
        android:height="10dp"
        android:width="10dp" />
</layer-list>
